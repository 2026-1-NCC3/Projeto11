<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/maya_background">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@color/maya_dark" android:padding="16dp" android:paddingTop="48dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Histórico" android:textColor="@color/white"
            android:textSize="22sp" android:textStyle="bold"/>
    </LinearLayout>

    <!-- Gráfico de evolução da dor -->
    <com.github.mikephil.charting.charts.LineChart
        android:id="@+id/line_chart"
        android:layout_width="match_parent" android:layout_height="160dp"
        android:layout_margin="12dp"/>

    <!-- Estado vazio -->
    <TextView android:id="@+id/tv_empty"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Nenhum registro ainda.\nFaça seu primeiro check-in!"
        android:textColor="@color/maya_text_secondary" android:gravity="center"
        android:textSize="15sp" android:padding="32dp" android:visibility="gone"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_checkins"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:padding="12dp" android:clipToPadding="false"/>
</LinearLayout>