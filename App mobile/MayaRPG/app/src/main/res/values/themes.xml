
<!-- ARQUIVO: res/values/themes.xml -->
<resources>
    <!-- Tema principal do app -->
    <style name="Theme.MayaRPG" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/maya_primary</item>
        <item name="colorPrimaryVariant">@color/maya_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/maya_secondary</item>
        <item name="android:windowBackground">@color/maya_background</item>
        <item name="android:statusBarColor">@color/maya_dark</item>
    </style>

    <!-- Tema da Splash sem action bar -->
    <style name="Theme.MayaRPG.Splash" parent="Theme.MayaRPG">
        <item name="android:windowBackground">@color/maya_dark</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <!-- Estilo de botão primário -->
    <style name="Button.Maya.Primary" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/maya_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Estilo de botão outline -->
    <style name="Button.Maya.Outline" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/maya_primary</item>
        <item name="android:textColor">@color/maya_primary</item>
        <item name="cornerRadius">10dp</item>
    </style>

    <!-- Card padrão -->
    <style name="Card.Maya" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/maya_surface</item>
        <item name="cardCornerRadius">14dp</item>
        <item name="cardElevation">2dp</item>
        <item name="strokeColor">@color/maya_border</item>
        <item name="strokeWidth">1dp</item>
    </style>
</resources>