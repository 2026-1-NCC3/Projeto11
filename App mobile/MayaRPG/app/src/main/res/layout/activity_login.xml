<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/maya_dark"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Hero com logo -->
        <LinearLayout
            android:id="@+id/ll_hero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="64dp"
            android:paddingBottom="32dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="maya"
                android:textColor="@color/maya_primary"
                android:textSize="42sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="yamamoto · rpg"
                android:textColor="#80FFFFFF"
                android:textSize="12sp"
                android:letterSpacing="0.15"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Seu plano de reabilitação personalizado"
                android:textColor="#60FFFFFF"
                android:textSize="12sp"
                android:layout_marginTop="8dp"/>
        </LinearLayout>

        <!-- Banner modo demonstração -->
        <TextView
            android:id="@+id/tv_demo_warning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="MODO DEMONSTRAÇÃO — Funcionando sem conexão com o servidor"
            android:textColor="@color/maya_dark"
            android:textSize="12sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="10dp"
            android:background="@color/maya_demo_banner"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/ll_hero"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Card branco com formulário -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/maya_background"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:layout_constraintTop_toBottomOf="@id/tv_demo_warning"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Acesso do Paciente"
                    android:textColor="@color/maya_text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="24dp"/>

                <!-- Campo E-mail -->
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="E-MAIL" android:textSize="11sp" android:textColor="@color/maya_text_secondary"
                    android:textStyle="bold" android:letterSpacing="0.08" android:layout_marginBottom="6dp"/>
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textColorHint="@color/maya_text_secondary"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_marginBottom="16dp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_email"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:hint="seu@email.com"
                        android:textColor="@color/maya_text_primary"
                        android:inputType="textEmailAddress"
                        android:imeOptions="actionNext"/>
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Campo Senha -->
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="SENHA" android:textSize="11sp" android:textColor="@color/maya_text_secondary"
                    android:textStyle="bold" android:letterSpacing="0.08" android:layout_marginBottom="6dp"/>
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textColorHint="@color/maya_text_secondary"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    app:passwordToggleEnabled="true"
                    android:layout_marginBottom="8dp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_password"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:hint="••••••••"
                        android:textColor="@color/maya_text_primary"
                        android:inputType="textPassword"
                        android:imeOptions="actionDone"/>
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Link Esqueci minha senha -->
                <TextView
                    android:id="@+id/tv_forgot_password"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Esqueci minha senha"
                    android:textColor="@color/maya_primary"
                    android:textSize="13sp"
                    android:layout_gravity="end"
                    android:layout_marginBottom="20dp"
                    android:padding="4dp"/>

                <!-- Botão Entrar -->
                <Button
                    android:id="@+id/btn_login"
                    android:layout_width="match_parent" android:layout_height="52dp"
                    android:text="Entrar"
                    style="@style/Button.Maya.Primary"/>

                <!-- ProgressBar de loading -->
                <ProgressBar
                    android:id="@+id/progress_bar"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="8dp"
                    android:visibility="gone"
                    android:indeterminateTint="@color/maya_primary"/>

                <!-- Link Criar conta -->
                <TextView
                    android:id="@+id/tv_register"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Primeiro acesso? Criar conta"
                    android:textColor="@color/maya_text_secondary"
                    android:gravity="center"
                    android:padding="16dp"
                    android:textSize="14sp"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
