<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_margin="6dp" style="@style/Card.Maya">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="14dp">
        <TextView android:id="@+id/tv_checkin_date"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/maya_text_light" android:textSize="11sp"/>
        <TextView android:id="@+id/tv_checkin_title"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/maya_text_primary" android:textSize="15sp"
            android:textStyle="bold" android:layout_marginTop="2dp"/>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="6dp" android:gravity="center_vertical">
            <TextView android:id="@+id/tv_checkin_status"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/maya_dark" android:textSize="11sp"
                android:textStyle="bold" android:background="@color/maya_primary_light"
                android:paddingHorizontal="8dp" android:paddingVertical="3dp"/>
            <TextView android:id="@+id/tv_checkin_pain"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/maya_brown" android:textSize="11sp"
                android:background="@color/maya_secondary_light"
                android:paddingHorizontal="8dp" android:paddingVertical="3dp"
                android:layout_marginStart="6dp"/>
        </LinearLayout>
        <TextView android:id="@+id/tv_checkin_notes"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/maya_text_secondary" android:textSize="12sp"
            android:fontStyle="italic" android:layout_marginTop="6dp"/>
        <!-- Botões editar/excluir -->
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="10dp">
            <Button android:id="@+id/btn_edit_checkin"
                android:layout_width="wrap_content" android:layout_height="36dp"
                android:text="Editar" style="@style/Button.Maya.Outline"
                android:textSize="12sp" android:layout_marginEnd="8dp"/>
            <Button android:id="@+id/btn_delete_checkin"
                android:layout_width="wrap_content" android:layout_height="36dp"
                android:text="Excluir"
                android:textColor="@color/maya_secondary"
                android:backgroundTint="@android:color/transparent"
                android:strokeColor="@color/maya_secondary"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:textSize="12sp"/>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
