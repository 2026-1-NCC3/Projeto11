<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/maya_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@color/maya_dark" android:padding="16dp" android:paddingTop="48dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Check-in de Sessão" android:textColor="@color/white"
                android:textSize="18sp" android:textStyle="bold"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp">

            <!-- Seletor de exercício -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="EXERCÍCIO REALIZADO" android:textColor="@color/maya_text_secondary"
                android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.08"
                android:layout_marginBottom="6dp"/>
            <Spinner android:id="@+id/spinner_exercise"
                android:layout_width="match_parent" android:layout_height="52dp"
                android:background="@drawable/bg_spinner"
                android:layout_marginBottom="16dp"/>

            <!-- Nível de dor -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="NÍVEL DE DOR (0-10)" android:textColor="@color/maya_text_secondary"
                android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.08"
                android:layout_marginBottom="6dp"/>
            <SeekBar android:id="@+id/seekbar_pain"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:max="10" android:progress="0"
                android:thumbTint="@color/maya_primary"
                android:progressTint="@color/maya_primary"/>
            <TextView android:id="@+id/tv_pain_value"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="0 — Sem dor" android:textColor="@color/maya_primary"
                android:textSize="13sp" android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp"/>

            <!-- Status de conclusão -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="SESSÃO COMPLETADA?" android:textColor="@color/maya_text_secondary"
                android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.08"
                android:layout_marginBottom="6dp"/>
            <RadioGroup android:id="@+id/rg_completion"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="16dp">
                <RadioButton android:id="@+id/rb_complete" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="Completo" android:buttonTint="@color/maya_primary"/>
                <RadioButton android:id="@+id/rb_partial" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="Parcial" android:buttonTint="@color/maya_warning"/>
                <RadioButton android:id="@+id/rb_not_done" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="Não fiz" android:buttonTint="@color/maya_secondary"/>
            </RadioGroup>

            <!-- Observações -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="OBSERVAÇÕES (OPCIONAL)" android:textColor="@color/maya_text_secondary"
                android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.08"
                android:layout_marginBottom="6dp"/>
            <EditText android:id="@+id/et_notes"
                android:layout_width="match_parent" android:layout_height="100dp"
                android:hint="Ex.: Senti desconforto no joelho direito..."
                android:inputType="textMultiLine" android:gravity="top"
                android:background="@drawable/bg_input"
                android:padding="12dp" android:layout_marginBottom="20dp"/>

            <Button android:id="@+id/btn_save_checkin"
                android:layout_width="match_parent" android:layout_height="52dp"
                android:text="Salvar check-in" style="@style/Button.Maya.Primary"/>

        </LinearLayout>
    </LinearLayout>
</ScrollView>
