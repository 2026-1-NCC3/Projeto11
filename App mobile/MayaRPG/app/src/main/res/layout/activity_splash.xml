<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/maya_dark"
    android:orientation="vertical"
    android:gravity="center">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="maya"
        android:textColor="@color/maya_primary"
        android:textSize="52sp"
        android:textStyle="bold"
        android:letterSpacing="-0.03"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="yamamoto · rpg"
        android:textColor="#99FFFFFF"
        android:textSize="14sp"
        android:letterSpacing="0.15"
        android:layout_marginTop="4dp"/>

    <TextView
        android:id="@+id/tv_splash_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Verificando conexão..."
        android:textColor="#66FFFFFF"
        android:textSize="12sp"
        android:layout_marginTop="48dp"/>

    <ProgressBar
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="16dp"
        android:indeterminateTint="@color/maya_primary"/>

</LinearLayout>
